    "function_v0": {
      "doc": "Execute a proposal that has passed.\\n\\nConditions (all must hold):\\n1. Voting window has closed.\\n2. Timelock delay has elapsed since voting closed.\\n3. Total votes cast >= quorum.\\n4. `for_votes > against_votes`.\\n5. Not already executed or cancelled.",
      "name": "execute",
      "inputs": [
        {
          "doc": "",
          "name": "proposal_id",
          "type_": "u32"
        }
      ],
