        },
        {
          "doc": "",
          "name": "quorum",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "voting_period",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "timelock",
          "type_": "u32"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "tuple": {
                "value_types": []
              }
            },
            "error_type": {
              "udt": {
