                "name": "GovernanceError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Cancel a proposal.\\n\\nRules (PoC):\\n- During voting: only the admin may cancel.\\n- After voting, without quorum: anyone may cancel (failed proposal).\\n- After voting, with quorum: only the admin may cancel (emergency\\noverride \\xe2\\x80\\x94 a production system would remove this power).",
      "name": "cancel",
      "inputs": [
        {
          "doc": "",
          "name": "proposal_id",
          "type_": "u32"
        }
      ],
      "outputs": [
