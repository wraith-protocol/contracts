    "function_v0": {
      "doc": "Initialise the governance contract.\\n\\nMust be called exactly once. After init the admin can create and cancel\\nproposals \\xe2\\x80\\x94 in production this role should be renounced or replaced by\\nthe governance process itself.\\n\\n# Arguments\\n* `admin`          \\xe2\\x80\\x94 Address with super-admin powers (PoC only).\\n* `token`          \\xe2\\x80\\x94 SAC token used for voting weight.\\n* `quorum`         \\xe2\\x80\\x94 Absolute minimum total tokens required for a valid vote.\\n* `voting_period`  \\xe2\\x80\\x94 Duration of voting window in ledgers.\\n* `timelock`       \\xe2\\x80\\x94 Delay after voting closes before execution (ledgers).",
      "name": "init",
      "inputs": [
        {
          "doc": "",
          "name": "admin",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token",
