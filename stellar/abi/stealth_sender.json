          "type_": "address"
        },
        {
          "doc": "",
          "name": "ephemeral_pub_key",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "metadata",
          "type_": "bytes"
        }
