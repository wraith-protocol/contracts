          "value": 8
        },
        {
          "doc": "The caller is not a current governance signer.",
          "name": "NotSigner",
          "value": 9
        },
        {
          "doc": "The requested threshold is invalid (zero, or greater than signer count).",
          "name": "InvalidThreshold",
          "value": 10
        },
        {
          "doc": "A signer-rotation proposal is already pending.",
          "name": "RotationAlreadyPending",
          "value": 11
        },
        {
          "doc": "No signer-rotation proposal is pending.",
          "name": "NoPendingRotation",
          "value": 12
