{
  "name": "@wraith/subgraph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "manifest": "npm --prefix ../../scripts/deployment-manifest run --silent subgraph --",
    "codegen": "graph codegen subgraph.template.yaml",
    "build": "graph build subgraph.template.yaml",
    "test": "graph test --version 0.6.0",
    "test:coverage": "graph test --coverage --version 0.6.0",
    "deploy": "npm run manifest -- --check && graph deploy",
    "create-local": "graph create --node http://localhost:8020 wraith-protocol/wraith",
    "deploy-local": "npm run manifest -- --check && graph deploy --node http://localhost:8020 --ipfs http://localhost:5001 wraith-protocol/wraith"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.96.0",
    "@graphprotocol/graph-ts": "^0.37.0",
    "matchstick-as": "0.6.0"
  }
}
